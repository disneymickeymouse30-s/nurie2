# ===== Coloria 環境変数サンプル =====
# Phase 1（現在）は環境変数なしで動作します。写真→線画変換は端末内で行います。
#
# ---- Phase 2 以降（サーバー側でのみ使用。VITE_ で始めないこと＝ブラウザに公開されません）----
# AI 画像変換サービスの API キー（サーバーの環境変数にのみ置く）
AI_IMAGE_PROVIDER=mock            # mock | openai | replicate など
AI_IMAGE_API_KEY=
# 1ユーザーあたりの AI 変換回数の上限（無料プラン、月あたり）
AI_FREE_MONTHLY_LIMIT=5

# ---- Supabase（認証・DB・Storage）----
# ブラウザで使ってよいのは anon キーだけ（RLS で保護する前提）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# service_role キーはサーバー専用。絶対にクライアントへ渡さない
SUPABASE_SERVICE_ROLE_KEY=
